{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "streaming-scrape-us",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "bae3f835f19899c6eee1ec48f2d658cf",
	"workers_dev": false,
	"placement": {
		"region": "aws:us-east-1"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	"env": {
		"preview": {
			// Explicit so Workers Builds name-check matches streaming-scrape-us-preview.
			"name": "streaming-scrape-us-preview",
			"workers_dev": true,
			"placement": {
				"region": "aws:us-east-1"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"observability": {
				"enabled": true,
				"logs": {
					"invocation_logs": false
				}
			}
		}
	}
}
