{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "streaming-scrape-us",
	"main": "workers/streaming-scrape-us/src/index.ts",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "bae3f835f19899c6eee1ec48f2d658cf",
	// Service-binding only (Api SCRAPE_US). No public workers.dev / preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"placement": {
		"region": "aws:us-east-1"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	"env": {
		"preview": {
			// Explicit so Workers Builds name-check can target streaming-scrape-us-preview.
			"name": "streaming-scrape-us-preview",
			"workers_dev": false,
			"preview_urls": false,
			"placement": {
				"region": "aws:us-east-1"
			},
			"observability": {
				"enabled": true,
				"logs": {
					"invocation_logs": false
				}
			}
		}
	}
}
