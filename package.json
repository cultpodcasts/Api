{
  "name": "cultpodcasts-api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:scrape-us": "wrangler deploy -c ./wrangler.streaming-scrape-us.jsonc",
    "deploy:scrape-us:preview": "wrangler deploy -c ./wrangler.streaming-scrape-us.jsonc --env preview",
    "publish:contract:production": "node ./scripts/publish-streaming-submit-contract.mjs production",
    "publish:contract:staging": "node ./scripts/publish-streaming-submit-contract.mjs staging",
    "start": "wrangler dev --env local --ip 127.0.0.1 --port 8787 --local-protocol https --https-cert-path ./.cert/dev-cert.pem --https-key-path ./.cert/dev-key.pem",
    "og:preview": "pwsh -File ./scripts/og-card-preview.ps1 -Open",
    "og:preview:preview": "pwsh -File ./scripts/og-card-preview.ps1 -BaseUrl https://api-preview.jonbreen.workers.dev -Open",
    "test": "vitest run",
    "test:br:field": "pwsh -File ./scripts/br-field-probe/run-field-test.ps1",
    "test:br:itvx": "pwsh -File ./scripts/br-field-probe/run-field-test.ps1 -Service itvx",
    "survey:streaming-scrape": "pwsh -File ./scripts/streaming-scrape-survey/run-survey.ps1",
    "survey:compare-contract": "pwsh -File ./scripts/streaming-scrape-survey/compare-survey-to-contract.ps1",
    "lint": "tsc --noEmit",
    "assert:secrets-parity": "pwsh ./scripts/assert-secrets-example-parity.ps1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@cfworker/jwt": "^4.0.6",
    "@cloudflare/puppeteer": "^1.4.0",
    "@prisma/adapter-d1": "^5.13.0",
    "@prisma/client": "^5.13.0",
    "chanfana": "^3.4.0",
    "hono": "^4.13.13",
    "prisma": "^5.13.0",
    "workers-og": "^0.0.27",
    "yoga-wasm-web": "^0.3.3"
  }
}
